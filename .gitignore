# --- Combined .gitignore ---

# Model files & Checkpoints (Too large for GitHub)
models/
checkpoints/
src/checkpoints/
src/test-checkpoints/
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
*.h5
*.pkl
*.pickle

# Temporary & Cache
tmp*/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.pytest_cache/
.cache/
*.cache

# Logs
logs*/
*.log

# Optuna
optuna_studies/
optuna_study.db

# Results (Exclude large checkpoints/binaries)
results/*/checkpoint-*/
results/*/*.bin
results/*/*.safetensors
experiments/results/

# Environment
.env
.env.local
.env.*.local
.venv
.venv/
env/
venv/
ENV/

# IDE & Editors
.vscode/
.idea/
*.swp
*.swo
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# OS specific
.DS_Store
Thumbs.db

# Data files (Use Git LFS if needed)
*.csv
*.tsv
*.jsonl
data/raw/
data/processed/
data/augmented/

# Distribution / Packaging
dist/
build/
*.egg-info/

# Credentials
credentials.json
token.json

# Backups
backup_*/